# Copy to .env.local, then replace these two values with Clerk development keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_CLERK_DEVELOPMENT_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_CLERK_DEVELOPMENT_SECRET_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
DATABASE_URL=postgresql://localhost:5432/career_workspace
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_DEVELOPMENT_KEY
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODEL=openai/gpt-6-luna
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
# Set STORAGE_DRIVER=r2 and provide these server-only credentials to use R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Dodo Payments development checkout (test mode only).
DODO_PAYMENTS_API_KEY=REPLACE_WITH_DODO_TEST_KEY
DODO_PAYMENTS_WEBHOOK_SECRET=REPLACE_WITH_DODO_TEST_WEBHOOK_SECRET
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/workspace/credits
DODO_PRODUCT_STARTER=REPLACE_WITH_STARTER_PRODUCT_ID
DODO_PRODUCT_JOBHUNT=REPLACE_WITH_JOBHUNT_PRODUCT_ID
DODO_PRODUCT_FULLSEASON=REPLACE_WITH_FULLSEASON_PRODUCT_ID

# LinkedIn is the first publishing platform; enable only after live provider checks.
FEATURE_PUBLISHING=false
PUBLISHING_PLATFORM=linkedin
APP_URL=https://REPLACE_WITH_YOUR_APP_HOST
ZERNIO_API_KEY=REPLACE_WITH_ZERNIO_API_KEY

FEATURE_PRACTICE=false
ZERNIO_WEBHOOK_SECRET=REPLACE_WITH_ZERNIO_WEBHOOK_SECRET

# Optional folder when sharing a private R2 bucket.
# R2_KEY_PREFIX=career-workspace/

# Daily public job collection and CV-based matches
FEATURE_DISCOVERY=false
CRON_SECRET=replace-with-a-random-secret
