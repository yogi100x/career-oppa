{
  "manifest_version": 3,
  "name": "Career-Oppa",
  "version": "0.1.0",
  "description": "Save a visible job posting to your private Career-Oppa workspace.",
  "key": "",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://cool-llama-4046.clerk.accounts.dev/*"
  ],
  "action": {
    "default_popup": "index.html"
  }
}
